          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1NodeStatus"
        },
        "output": {},
        "errorMessage": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "format": "int64"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
