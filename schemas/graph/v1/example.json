{
  "apiVersion": "graph/v1",
  "id": "checkout-workflow",
  "name": "Checkout Graph",
  "description": "An example checkout graph processing an order.",
  "nodes": [
    {
      "id": "start",
      "type": "passthrough",
      "config": {}
    },
    {
      "id": "validate-order",
      "type": "transform",
      "config": {
        "schema": "order_schema"
      }
    },
    {
      "id": "reserve-inventory",
      "type": "http_call",
      "config": {
        "url": "https://inventory.example.com/reserve",
        "method": "POST"
      },
      "retryPolicy": "standard-retry",
      "compensation": "cancel-inventory"
    },
    {
      "id": "check-discount",
      "type": "conditional_branch",
      "config": {}
    },
    {
      "id": "wait-for-payment",
      "type": "wait_for_signal",
      "config": {
        "signalName": "payment_success"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "validate-order"
    },
    {
      "from": "validate-order",
      "to": "reserve-inventory",
      "dataMapping": {
        "orderId": "start.orderId"
      }
    },
    {
      "from": "reserve-inventory",
      "to": "check-discount"
    },
    {
      "from": "check-discount",
      "to": "wait-for-payment",
      "condition": "reserve-inventory.status == 'reserved'"
    }
  ],
  "retryPolicies": {
    "standard-retry": {
      "maxAttempts": 3,
      "initialIntervalMs": 1000,
      "backoffCoefficient": 2,
      "maxIntervalMs": 10000
    }
  },
  "compensations": {
    "cancel-inventory": {
      "type": "http_call",
      "config": {
        "url": "https://inventory.example.com/cancel",
        "method": "POST"
      }
    }
  },
  "failurePolicy": {
    "onNodeFailure": "fail_graph",
    "onCriticalFailure": "compensate"
  }
}
