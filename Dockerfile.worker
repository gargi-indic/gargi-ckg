# Multi-stage Dockerfile for Gargi Worker

# Build stage
FROM golang:alpine AS builder
RUN apk add --no-cache ca-certificates git build-base

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/gargi-worker ./cmd/worker

# Final runtime image
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app
COPY --from=builder /bin/gargi-worker /bin/gargi-worker
COPY config/config.example.yaml /app/config/config.yaml

USER nobody:nobody

ENTRYPOINT ["/bin/gargi-worker"]
CMD ["-config", "/app/config/config.yaml"]
