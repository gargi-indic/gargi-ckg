# LOCAL DEV ONLY - Default credentials for local docker-compose environment

# Postgres App Database
POSTGRES_USER=gargi
POSTGRES_PASSWORD=gargi_local_secret
POSTGRES_DB=gargi_db

# Temporal Postgres Database
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_local_secret
TEMPORAL_POSTGRES_DB=temporal_db

# Neo4j
NEO4J_AUTH=neo4j/neo4j_local_secret
