{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gargi-ckg:schema:graph:v1",
  "title": "Gargi CKG Graph Definition",
  "description": "Version 1 Graph Definition Schema for Gargi CKG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "nodes"
  ],
  "properties": {
    "apiVersion": {
      "const": "graph/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "retryPolicies": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$": {
          "$ref": "#/$defs/RetryPolicy"
        }
      }
    },
    "compensations": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$": {
          "$ref": "#/$defs/Compensation"
        }
      }
    },
    "failurePolicy": {
      "$ref": "#/$defs/FailurePolicy"
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "config": {
          "type": "object",
          "description": "Free-form object validated per node type"
        },
        "retryPolicy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "compensation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "An opaque expression. Conditions are not evaluated or validated yet. Absent condition means 'always'."
        },
        "dataMapping": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^.+$": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Maximum number of execution attempts. 1 means no retry."
        },
        "initialIntervalMs": {
          "type": "integer",
          "minimum": 1
        },
        "backoffCoefficient": {
          "type": "number",
          "minimum": 1,
          "default": 2
        },
        "maxIntervalMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "config": {
          "type": "object",
          "description": "Free-form object validated per compensation handler type"
        }
      }
    },
    "FailurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onNodeFailure": {
          "type": "string",
          "enum": [
            "fail_graph",
            "continue"
          ],
          "default": "fail_graph",
          "description": "What happens after a node fails with a non-retryable error or exhausts retries."
        },
        "onCriticalFailure": {
          "type": "string",
          "enum": [
            "compensate",
            "fail_graph"
          ],
          "default": "compensate"
        }
      }
    }
  }
}
