# Multi-stage Dockerfile for Gargi Server

# Build stage
FROM golang:alpine AS builder
RUN apk add --no-cache ca-certificates git build-base

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/gargi-server ./cmd/server

# Final runtime image
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata curl

WORKDIR /app
COPY --from=builder /bin/gargi-server /bin/gargi-server
COPY config/config.example.yaml /app/config/config.yaml

EXPOSE 8080 9090

USER nobody:nobody

ENTRYPOINT ["/bin/gargi-server"]
CMD ["-config", "/app/config/config.yaml"]
