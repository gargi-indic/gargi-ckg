  "paths": {
    "/v1/executions": {
      "post": {
        "summary": "SubmitExecution submits a new graph definition for asynchronous execution.",
        "operationId": "GargiService_SubmitExecution",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SubmitExecutionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "SubmitExecutionRequest defines the payload for submitting a graph execution.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SubmitExecutionRequest"
            }
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    },
    "/v1/executions/{executionId}": {
      "get": {
        "summary": "GetExecution queries the state of a graph execution.",
        "operationId": "GargiService_GetExecution",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetExecutionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    },
    "/v1/executions/{executionId}/cancel": {
      "post": {
        "summary": "CancelExecution cancels an in-flight graph execution.",
        "operationId": "GargiService_CancelExecution",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CancelExecutionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GargiServiceCancelExecutionBody"
            }
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    },
    "/v1/executions/{executionId}/nodes/{nodeId}": {
      "get": {
        "summary": "GetNodeState queries the execution state of an individual node in the graph.",
        "operationId": "GargiService_GetNodeState",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetNodeStateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    },
    "/v1/executions/{executionId}/nodes/{nodeId}/signal": {
      "post": {
        "summary": "SignalNode delivers an external event or signal to a node.",
        "operationId": "GargiService_SignalNode",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SignalNodeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GargiServiceSignalNodeBody"
            }
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    },
    "/v1/executions/{executionId}/stream": {
      "get": {
        "summary": "StreamExecutionUpdates opens a server-streaming channel for reactive execution events.",
        "operationId": "GargiService_StreamExecutionUpdates",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StreamExecutionUpdatesResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1StreamExecutionUpdatesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "fromSequence",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "GargiService"
        ]
      }
    }
  },
