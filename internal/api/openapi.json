        },
        "executionId": {
          "type": "string",
          "description": "Optional idempotency key / custom execution ID."
        },
        "inputs": {
          "type": "object",
          "description": "Initial input variables for the graph execution."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Metadata associated with this execution."
        }
      },
      "description": "SubmitExecutionRequest defines the payload for submitting a graph execution."
    },
    "v1SubmitExecutionResponse": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1ExecutionStatus"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
